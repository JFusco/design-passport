{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>JFusco/renovate-config:standard"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* * * * 1"
    ]
  },
  "constraints": {
    "pnpm": "10.33.0"
  },
  "packageRules": [
    {
      "description": "Regenerate the root UI catalog only when its owning package changes.",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "ui-design-brain"
      ],
      "matchFileNames": [
        "package.json"
      ],
      "postUpgradeTasks": {
        "commands": [
          "pnpm install --frozen-lockfile --ignore-scripts",
          "pnpm catalog:sync"
        ],
        "executionMode": "branch",
        "fileFilters": [
          "src/generated/ui-design-brain.catalog.json"
        ],
        "installTools": {
          "pnpm": {}
        }
      }
    }
  ],
  "enabledManagers": [
    "npm"
  ]
}
