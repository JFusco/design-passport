{
  "name": "figma-ai-ready",
  "version": "0.1.0",
  "private": true,
  "description": "Private Figma plugin for deterministic AI-readiness audits, repair planning, and certification.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "catalog:sync": "node scripts/sync-catalog.mjs",
    "catalog:check": "node scripts/sync-catalog.mjs --check",
    "schemas:generate": "node scripts/generate-schema-validators.mjs",
    "schemas:check": "node scripts/generate-schema-validators.mjs --check",
    "wiki:check": "node scripts/wiki/check.cjs",
    "build:ui": "vite build",
    "build:plugin": "esbuild src/plugin/main.ts --bundle --outfile=dist/code.js --format=iife --target=es2020 --platform=browser --log-level=warning",
    "build": "pnpm catalog:sync && pnpm schemas:generate && pnpm build:ui && pnpm build:plugin",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "lint:commit": "commitlint --config commitlint.config.cjs",
    "lint:commits:last": "pnpm run lint:commit --last",
    "verify:ci": "pnpm catalog:check && pnpm schemas:check && pnpm wiki:check && pnpm typecheck && pnpm test && pnpm build",
    "verify": "pnpm run verify:ci",
    "verify:push": "pnpm run verify:ci",
    "prepare": "husky",
    "commit": "ai-commit run",
    "pr:create": "ai-pr"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.132.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@verndale/ai-commit": "2.7.0",
    "@verndale/ai-pr": "1.3.5",
    "@verndale/ui-design-brain": "1.17.0",
    "@vitejs/plugin-react": "5.0.2",
    "dotenv": "16.6.1",
    "esbuild": "0.25.9",
    "husky": "9.1.7",
    "typescript": "5.9.2",
    "vite": "7.1.4",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "3.2.4"
  }
}
