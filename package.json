{
  "name": "figma-ai-ready",
  "version": "0.4.0",
  "private": true,
  "description": "Organization-published private Figma plugin for deterministic AI-readiness audits, repair planning, and certification.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "catalog:sync": "node scripts/sync-catalog.mjs",
    "catalog:check": "node scripts/sync-catalog.mjs --check",
    "schemas:generate": "node scripts/generate-schema-validators.mjs",
    "schemas:check": "node scripts/generate-schema-validators.mjs --check",
    "knowledge:check": "node scripts/check-team-knowledge.mjs",
    "wiki:check": "node scripts/wiki/check.cjs",
    "build:ui": "vite build",
    "build:plugin": "node scripts/build-plugin.mjs",
    "build:metadata": "node scripts/write-build-metadata.mjs",
    "build:development-bundle": "node scripts/sync-development-bundle.mjs",
    "build:companion": "esbuild src/companion/main.ts --bundle --outfile=dist/companion.mjs --format=esm --target=node24 --platform=node --log-level=warning",
    "build:companion-app": "pnpm --filter @design-passport/companion build",
    "companion": "node dist/companion.mjs",
    "companion:dev": "pnpm --filter @design-passport/companion dev",
    "companion:build": "pnpm run build:companion && pnpm run build:companion-app",
    "companion:start": "pnpm --filter @design-passport/companion start",
    "build:artifacts": "pnpm catalog:sync && pnpm schemas:generate && pnpm build:ui && pnpm build:plugin && pnpm build:companion && pnpm build:metadata",
    "build:development-artifacts": "DESIGN_PASSPORT_CHANNEL=development pnpm build:artifacts",
    "build": "pnpm build:development-artifacts && pnpm build:development-bundle",
    "build:release": "DESIGN_PASSPORT_CHANNEL=production pnpm build:artifacts",
    "typecheck": "tsc --noEmit",
    "typecheck:companion": "tsc --project tsconfig.companion.json --noEmit && pnpm --filter @design-passport/companion typecheck",
    "lint:companion": "eslint apps/companion src/companion playwright.config.ts tests/companion-*.test.ts tests/e2e",
    "test:companion": "vitest run --config vitest.config.ts tests/companion-*.test.ts",
    "test:companion:e2e": "playwright test",
    "skills:check": "node scripts/check-skills.cjs",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "lint:commit": "commitlint --config commitlint.config.cjs",
    "lint:commits:last": "pnpm run lint:commit --last",
    "verify:ci": "pnpm catalog:check && pnpm schemas:check && pnpm knowledge:check && pnpm wiki:check && pnpm skills:check && pnpm typecheck && pnpm typecheck:companion && pnpm lint:companion && pnpm test && pnpm build:companion-app && pnpm test:companion:e2e && pnpm build",
    "verify": "pnpm run verify:ci",
    "verify:push": "pnpm run verify:ci",
    "prepare": "husky",
    "commit": "ai-commit run",
    "pr:create": "ai-pr"
  },
  "dependencies": {
    "ajv": "8.18.0",
    "fflate": "0.8.3",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@figma/plugin-typings": "1.132.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@verndale/ai-commit": "2.7.0",
    "@verndale/ai-pr": "1.3.5",
    "@verndale/ui-design-brain": "1.17.0",
    "@vitejs/plugin-react": "5.0.2",
    "dotenv": "16.6.1",
    "esbuild": "0.25.9",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "typescript": "5.9.2",
    "typescript-eslint": "8.70.0",
    "vite": "7.1.4",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "3.2.4"
  }
}
