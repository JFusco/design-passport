{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verndale.com/schemas/figma-ai-ready/design-reference-pack.schema.json",
  "title": "DesignReferencePackV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packVersion", "source", "facts", "generatedAt", "digest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packVersion": { "type": "string", "minLength": 1, "maxLength": 50 },
    "source": { "$ref": "https://verndale.com/schemas/figma-ai-ready/review-source.schema.json" },
    "facts": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/fact" } },
    "generatedAt": { "type": "string", "format": "date-time" },
    "digest": { "$ref": "https://verndale.com/schemas/figma-ai-ready/definitions.schema.json#/$defs/digest" }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factId", "domain", "label", "guidance", "matcher", "provenance"],
      "properties": {
        "factId": { "$ref": "https://verndale.com/schemas/figma-ai-ready/definitions.schema.json#/$defs/opaqueId" },
        "domain": { "$ref": "https://verndale.com/schemas/figma-ai-ready/definitions.schema.json#/$defs/referenceDomain" },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "guidance": { "type": "string", "minLength": 1, "maxLength": 500 },
        "matcher": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "informational" } } },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "field", "allowedValues"],
              "properties": {
                "kind": { "const": "numeric-node-field" },
                "field": { "type": "string", "enum": ["itemSpacing", "paddingTop", "paddingRight", "paddingBottom", "paddingLeft", "cornerRadius", "frameWidth"] },
                "allowedValues": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "number" } }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "nodeTypes", "allowedValues"],
              "properties": {
                "kind": { "const": "node-name" },
                "nodeTypes": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 50 } },
                "allowedValues": { "type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }
              }
            }
          ]
        },
        "provenance": { "type": "string", "enum": ["figma-derived", "approved-project", "shared"] },
        "candidateDigest": { "$ref": "https://verndale.com/schemas/figma-ai-ready/definitions.schema.json#/$defs/digest" }
      }
    }
  }
}
