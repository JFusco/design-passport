{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verndale.com/schemas/figma-ai-ready/multi-file-review-report.schema.json",
  "title": "MultiFileReviewReportV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectScope", "targets", "references", "limitingTargetSourceId", "grade", "ready", "certificationEligible", "warnings", "generatedAt", "digest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectScope": { "$ref": "https://verndale.com/schemas/figma-ai-ready/definitions.schema.json#/$defs/opaqueId" },
    "targets": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/target" } },
    "references": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/reference" } },
    "limitingTargetSourceId": { "$ref": "https://verndale.com/schemas/figma-ai-ready/definitions.schema.json#/$defs/opaqueId" },
    "grade": { "$ref": "https://verndale.com/schemas/figma-ai-ready/definitions.schema.json#/$defs/grade" },
    "ready": { "type": "boolean" },
    "certificationEligible": { "const": false },
    "warnings": { "type": "array", "maxItems": 500, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "generatedAt": { "type": "string", "format": "date-time" },
    "digest": { "$ref": "https://verndale.com/schemas/figma-ai-ready/definitions.schema.json#/$defs/digest" }
  },
  "$defs": {
    "target": {
      "type": "object", "additionalProperties": false, "required": ["source", "report"],
      "properties": {
        "source": { "$ref": "https://verndale.com/schemas/figma-ai-ready/review-source.schema.json" },
        "report": { "$ref": "https://verndale.com/schemas/figma-ai-ready/readiness-report.schema.json" }
      }
    },
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["sourceId", "packDigest"],
      "properties": {
        "sourceId": { "$ref": "https://verndale.com/schemas/figma-ai-ready/definitions.schema.json#/$defs/opaqueId" },
        "packDigest": { "$ref": "https://verndale.com/schemas/figma-ai-ready/definitions.schema.json#/$defs/digest" }
      }
    }
  }
}
