{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verndale.com/schemas/figma-ai-ready/review-learning-envelope.schema.json",
  "title": "ReviewLearningEnvelopeV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectScope", "producer", "reportDigest", "observations", "generatedAt", "digest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectScope": { "$ref": "https://verndale.com/schemas/figma-ai-ready/definitions.schema.json#/$defs/opaqueId" },
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["pluginVersion", "rulesetVersion", "catalogVersion", "knowledgeVersion"],
      "properties": {
        "pluginVersion": { "type": "string", "minLength": 1, "maxLength": 50 },
        "rulesetVersion": { "type": "string", "minLength": 1, "maxLength": 50 },
        "catalogVersion": { "type": "string", "minLength": 1, "maxLength": 50 },
        "knowledgeVersion": { "type": "string", "minLength": 1, "maxLength": 50 }
      }
    },
    "reportDigest": { "$ref": "https://verndale.com/schemas/figma-ai-ready/definitions.schema.json#/$defs/digest" },
    "observations": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/observation" } },
    "generatedAt": { "type": "string", "format": "date-time" },
    "digest": { "$ref": "https://verndale.com/schemas/figma-ai-ready/definitions.schema.json#/$defs/digest" }
  },
  "$defs": {
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["observationKey", "kind", "context", "direction", "count"],
      "properties": {
        "observationKey": { "$ref": "https://verndale.com/schemas/figma-ai-ready/definitions.schema.json#/$defs/opaqueId" },
        "kind": { "type": "string", "enum": ["naming-decision", "repeated-finding", "waiver-applied", "accepted-fix", "rescan-outcome"] },
        "context": { "type": "string", "minLength": 1, "maxLength": 100 },
        "direction": { "type": "string", "enum": ["support", "contradict"] },
        "ruleId": { "$ref": "https://verndale.com/schemas/figma-ai-ready/definitions.schema.json#/$defs/opaqueId" },
        "canonicalLabel": { "type": "string", "minLength": 1, "maxLength": 200 },
        "count": { "type": "integer", "minimum": 1, "maximum": 100000 }
      }
    }
  }
}
