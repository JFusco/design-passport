{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verndale.com/schemas/figma-ai-ready/knowledge-candidate.schema.json",
  "title": "KnowledgeCandidateV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidateId", "groupKey", "observationKey", "context", "sourceRoles", "projectScope", "wording", "proposedScope", "exceptions", "evidenceEnvelopeDigests", "supportCount", "contradictCount", "generatedAt", "digest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "candidateId": { "$ref": "https://verndale.com/schemas/figma-ai-ready/definitions.schema.json#/$defs/opaqueId" },
    "groupKey": { "$ref": "https://verndale.com/schemas/figma-ai-ready/definitions.schema.json#/$defs/opaqueId" },
    "observationKey": { "$ref": "https://verndale.com/schemas/figma-ai-ready/definitions.schema.json#/$defs/opaqueId" },
    "context": { "type": "string", "minLength": 1, "maxLength": 100 },
    "sourceRoles": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "$ref": "https://verndale.com/schemas/figma-ai-ready/definitions.schema.json#/$defs/reviewSourceRole" } },
    "projectScope": { "$ref": "https://verndale.com/schemas/figma-ai-ready/definitions.schema.json#/$defs/opaqueId" },
    "wording": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "proposedScope": { "type": "string", "enum": ["project", "shared"] },
    "exceptions": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "evidenceEnvelopeDigests": { "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "https://verndale.com/schemas/figma-ai-ready/definitions.schema.json#/$defs/digest" } },
    "supportCount": { "type": "integer", "minimum": 0 },
    "contradictCount": { "type": "integer", "minimum": 0 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "digest": { "$ref": "https://verndale.com/schemas/figma-ai-ready/definitions.schema.json#/$defs/digest" }
  }
}
