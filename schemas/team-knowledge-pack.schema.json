{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verndale.com/schemas/figma-ai-ready/team-knowledge-pack.schema.json",
  "title": "TeamKnowledgePackV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "knowledgeVersion", "entries", "generatedAt", "digest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "knowledgeVersion": { "type": "string", "minLength": 1, "maxLength": 50 },
    "entries": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/entry" } },
    "generatedAt": { "type": "string", "format": "date-time" },
    "digest": { "$ref": "https://verndale.com/schemas/figma-ai-ready/definitions.schema.json#/$defs/digest" }
  },
  "$defs": {
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["candidateId", "candidateDigest", "decisionId", "domain", "wording", "contexts"],
      "properties": {
        "candidateId": { "$ref": "https://verndale.com/schemas/figma-ai-ready/definitions.schema.json#/$defs/opaqueId" },
        "candidateDigest": { "$ref": "https://verndale.com/schemas/figma-ai-ready/definitions.schema.json#/$defs/digest" },
        "decisionId": { "$ref": "https://verndale.com/schemas/figma-ai-ready/definitions.schema.json#/$defs/opaqueId" },
        "domain": { "type": "string", "enum": ["tokens", "components", "naming", "layout", "breakpoints", "accessibility"] },
        "wording": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "contexts": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } }
      }
    }
  }
}
